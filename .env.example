# Local Atlas settings (safe development defaults only).
# Copy to `.env` for local overrides. Never commit real secrets.
# Docker Compose publishes Postgres on 127.0.0.1:5433 only (not all interfaces).
# Credentials below are development-only; do not use them outside local development.

ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@127.0.0.1:5433/atlas

# Background worker (python -m atlas.worker)
# Milestone 8 locally validated defaults:
# - 60s worker orchestration timeout (Future.result; does not kill threads)
# - 90s research-job lease
ATLAS_WORKER_POLL_INTERVAL_SECONDS=1
ATLAS_WORKER_PROCESSING_TIMEOUT_SECONDS=60
ATLAS_WORKER_LEASE_SECONDS=90

# Model provider (default: fake — deterministic, no network).
# Real OpenAI/Anthropic calls require explicit provider selection and credentials.
ATLAS_MODEL_PROVIDER=fake
# ATLAS_MODEL_NAME=gpt-4o-mini
# Provider request timeout + attempt deadline (not a hard whole-invoke wall clock).
# ATLAS_MODEL_CALL_TIMEOUT_SECONDS=25
ATLAS_PLAN_PROMPT_VERSION=plan.v1
ATLAS_DRAFT_PROMPT_VERSION=draft.v2
# ATLAS_OPENAI_API_KEY=
# ATLAS_ANTHROPIC_API_KEY=

# Embeddings / retrieval (default: fake — deterministic, no network).
ATLAS_EMBEDDING_PROVIDER=fake
ATLAS_EMBEDDING_PROFILE=embeddings.v1
# ATLAS_EMBEDDING_CALL_TIMEOUT_SECONDS=25
# ATLAS_RETRIEVAL_DEFAULT_K=5
# ATLAS_RETRIEVAL_USE_HNSW=true
# Opt-in live embedding tests (never enabled in CI):
# ATLAS_ENABLE_LIVE_EMBEDDING_TESTS=1

# Recovery / retry backoff (Slice 12B).
# ATLAS_RETRY_BASE_SECONDS=5.0
# ATLAS_RETRY_MAX_BACKOFF_SECONDS=60.0
# Default jitter 0 for deterministic local/CI; production may increase.
ATLAS_RETRY_JITTER_MAX_SECONDS=0

# Operator review API (Slice 12B). Off by default.
ATLAS_REVIEW_API_ENABLED=false

# Governed research tools (default: fake — no network).
# Live search uses Tavily via direct httpx when ATLAS_TOOL_PROVIDER=tavily.
ATLAS_TOOL_PROVIDER=fake
# Live fetch is unavailable in Milestone 9 (fails closed at composition).
ATLAS_TOOL_FETCH_ENABLED=false
# ATLAS_TOOL_ATTEMPT_TIMEOUT_SECONDS=8
# ATLAS_RESEARCH_NODE_TOOL_DEADLINE_SECONDS=45
# ATLAS_TOOL_MAX_LOGICAL_CALLS_PER_RESEARCH_NODE=6
# ATLAS_TOOL_MAX_ATTEMPTS_PER_CALL=2
# ATLAS_TAVILY_API_KEY=
# Opt-in live tool tests (never enabled in CI):
# ATLAS_ENABLE_LIVE_TOOL_TESTS=1

# Ephemeral coordination (Milestone 13 Slice 13A): rate limiting + worker
# heartbeats. Redis is never authoritative; PostgreSQL remains the source of
# truth. Library/Settings default is noop when unset. Docker Compose publishes
# Redis 8.8.1 on 127.0.0.1:6380 (offset from 6379). For local Compose use,
# explicitly select Redis (matches CI):
ATLAS_COORDINATION_PROVIDER=redis
ATLAS_REDIS_URL=redis://127.0.0.1:6380/0
# ATLAS_REDIS_CONNECT_TIMEOUT_SECONDS=0.2
# ATLAS_REDIS_SOCKET_TIMEOUT_SECONDS=0.2
# POST /v1/research-jobs rate limit, keyed by direct peer IP only
# (X-Forwarded-For is never trusted). Best-effort local/pre-auth abuse
# protection, not a security boundary. Idempotent replays count.
# ATLAS_RATE_LIMIT_MAX_REQUESTS=10
# ATLAS_RATE_LIMIT_WINDOW_SECONDS=60
# Worker heartbeat: dedicated daemon thread, independent of the poll/process
# loop (so a 60s processing window cannot expire a 15s TTL).
# ATLAS_HEARTBEAT_INTERVAL_SECONDS=5
# ATLAS_HEARTBEAT_TTL_SECONDS=15

# Transactional outbox relay (Milestone 13 Slice 13B). These knobs govern
# claim batching (fake-producer path; the Kafka relay always uses batch
# size 1 — see below) and publish leases.
# ATLAS_OUTBOX_RELAY_BATCH_SIZE=50
# ATLAS_OUTBOX_PUBLISH_LEASE_SECONDS=30

# Kafka outbox relay (Milestone 13 Slice 13C1): `python -m atlas.outbox`.
# Docker Compose publishes Kafka on 127.0.0.1:9094 (offset from the default
# 9092, which is reserved for other Compose containers on the internal
# network). kafka_delivery_timeout_seconds + margin must stay <=
# outbox_publish_lease_seconds (validated at Settings construction).
ATLAS_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9094
# ATLAS_KAFKA_DELIVERY_TIMEOUT_SECONDS=10
# ATLAS_KAFKA_SOCKET_TIMEOUT_SECONDS=10
# ATLAS_KAFKA_TOPIC_VERIFY_TIMEOUT_SECONDS=10
# ATLAS_KAFKA_DELIVERY_TIMEOUT_LEASE_MARGIN_SECONDS=5
# ATLAS_OUTBOX_RELAY_POLL_INTERVAL_SECONDS=1
