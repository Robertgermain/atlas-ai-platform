{
  "title": "Atlas Overview",
  "uid": "atlas-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": ["atlas"],
  "timezone": "utc",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP requests/sec by status class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(atlas_http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 5xx error ratio (5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "atlas:http_error_ratio:rate5m",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Worker processing outcomes/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(atlas_worker_processing_outcomes_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Outbox backlog: oldest unpublished age (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "atlas_outbox_backlog_age_seconds",
          "legendFormat": "oldest age (s)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Worker heartbeat: seconds since last success",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "time() - atlas_worker_heartbeat_last_success_timestamp_seconds",
          "legendFormat": "seconds since last success",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Model + tool attempts/sec by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(atlas_model_attempts_total[5m])) by (outcome)",
          "legendFormat": "model {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(atlas_tool_attempts_total[5m])) by (outcome)",
          "legendFormat": "tool {{outcome}}",
          "refId": "B"
        }
      ]
    }
  ]
}
